Options -Indexes
RewriteEngine On

# 1. Remove trailing slash — redirect /blog/ → /blog (skip root /)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 2. For clean paths that map to a directory, serve index.html internally
#    (browser URL stays as /blog, /blog/my-post, etc.)
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]
