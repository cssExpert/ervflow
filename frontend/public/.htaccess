Options -Indexes
RewriteEngine On

# Serve index.html for clean directory URLs (e.g. /company/about → company/about/index.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# ── Cache-Control headers ───────────────────────────────────
<IfModule mod_headers.c>
  # Next.js hashed static chunks — safe to cache 1 year immutable
  <FilesMatch "\.(js|css|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts — cache 1 year immutable
  <FilesMatch "\.(woff2|woff|ttf|eot|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Hashed images under _next/ — cache 1 year immutable
  <If "%{REQUEST_URI} =~ m|^/_next/|">
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|avif|svg)$">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
  </If>

  # Public images (no hash in name) — cache 30 days
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|avif)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # Icons and favicons — cache 30 days
  <FilesMatch "\.(svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # Sitemap / robots — cache 1 day
  <FilesMatch "\.(xml|xsl|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # HTML pages — always revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# ── Security headers ────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
